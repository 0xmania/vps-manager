NEXT_PUBLIC_SITE_ORIGIN=http://127.0.0.1:3000
CONTROL_PLANE_URL=http://localhost:8080

# Local development bridge
CONTROL_PLANE_DEV_BOOTSTRAP=replace-with-local-dev-value
CONTROL_PLANE_DEV_ROLE=admin

# Production identity bridge (configure all five; private JWK stays secret)
# CONTROL_PLANE_IDENTITY_ISSUER=https://your-private-site.example
# CONTROL_PLANE_IDENTITY_AUDIENCE=vps-manager-control-plane
# CONTROL_PLANE_IDENTITY_KEY_ID=web-bridge-1
# CONTROL_PLANE_IDENTITY_PRIVATE_JWK={"kty":"OKP","crv":"Ed25519",...}
# CONTROL_PLANE_IDENTITY_BINDINGS_JSON={"user:platform-user-id":{"role":"admin","allHosts":true,"hostIds":[]}}
